{
  "name": "jarvis-webchat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Source of the Jarvis web chat page and the phone app. The builds are committed to src/jarvis/webchat/static and src/jarvis/remote/static.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode phone",
    "build:web": "tsc --noEmit && vite build",
    "build:phone": "tsc --noEmit && vite build --mode phone",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "markdown-to-jsx": "^7.7.17",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
